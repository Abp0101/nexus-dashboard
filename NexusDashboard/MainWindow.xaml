<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NEXUS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NEXUS Dashboard">

    <!-- Note: WinUI 3 doesn't support blur filters directly on Ellipses easily without Win2D, 
         so we simulate it via a softer visual or just rely on opacity. 
         TileBrush isn't fully supported to draw grid lines natively without a backing image in standard WinUI, 
         so we use a subtle ImageBrush or skipped if unavailable. We'll use a standard layout. -->
    <Grid Background="#050810">
        <!-- Background Orbs -->
        <Grid>
            <!-- Top Left Violet -->
            <Ellipse Width="600" Height="600" Fill="#8B5CF6" Opacity="0.12" 
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-200,0,0" />
                     
            <!-- Center Right Cyan -->
            <Ellipse Width="500" Height="500" Fill="#00D4FF" Opacity="0.08" 
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,200,-150,0" />
                     
            <!-- Bottom center Green -->
            <Ellipse Width="400" Height="400" Fill="#10F59E" Opacity="0.06" 
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="400,0,0,-100" />
        </Grid>

        <!-- Subtle Grid Overlay Simulation (Optional, tough in pure XAML without an image) -->

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="32,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left side -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                        <Border Width="36" Height="36" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00D4FF" Offset="0" />
                                    <GradientStop Color="#8B5CF6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="N E X U S" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="SYSTEM MONITOR" FontSize="11" Foreground="{StaticResource TextMuted}" CharacterSpacing="200" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right side -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" />
                            <TextBlock Text="ALL SYSTEMS NOMINAL" FontSize="11" Foreground="{StaticResource AccentGreen}" CharacterSpacing="100" Margin="0,0,16,0" />
                        </StackPanel>
                        <TextBlock x:Name="ClockText" Text="10:45:00" FontSize="14" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WIDGET GRID (4 cols: 1fr 1fr 1fr 320px) (3 rows) -->
            <ScrollViewer Grid.Row="1" Padding="32">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 1 -->
                    <Border x:Name="CpuWidgetHost" Grid.Column="0" Grid.Row="0" VerticalAlignment="Stretch" />
                    <Border x:Name="GpuWidgetHost" Grid.Column="1" Grid.Row="0" VerticalAlignment="Stretch" />
                    <Border x:Name="RamWidgetHost" Grid.Column="2" Grid.Row="0" VerticalAlignment="Stretch" />
                    
                    <!-- Weather spans 2 rows -->
                    <Border x:Name="WeatherWidgetHost" Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Stretch" />

                    <!-- Row 2 -->
                    <!-- RGB spans 2 cols -->
                    <Border x:Name="RgbWidgetHost" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Stretch" />
                    <Border x:Name="StorageWidgetHost" Grid.Column="2" Grid.Row="1" VerticalAlignment="Stretch" />

                    <!-- Row 3 -->
                    <!-- Bluetooth spans 2 cols -->
                    <Border x:Name="BluetoothWidgetHost" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Stretch" />
                    <Border x:Name="NetworkWidgetHost" Grid.Column="2" Grid.Row="2" VerticalAlignment="Stretch" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
