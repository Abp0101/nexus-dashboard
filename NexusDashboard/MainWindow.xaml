<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NEXUS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEXUS"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NEXUS Dashboard">

    <Grid Background="#050810" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <TextBlock
            Grid.Row="0"
            Text="N E X U S"
            FontSize="36"
            FontWeight="Bold"
            Foreground="#AABBFF"
            HorizontalAlignment="Left"
            Margin="0,0,0,24"
            Opacity="0.9" />

        <!-- Row 1: CPU · GPU · RAM -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CpuWidgetHost" Grid.Column="0" VerticalAlignment="Top" />
            <Border x:Name="GpuWidgetHost" Grid.Column="2" VerticalAlignment="Top" />
            <Border x:Name="RamWidgetHost" Grid.Column="4" VerticalAlignment="Top" />
        </Grid>

        <!-- Row 2: Weather · Bluetooth -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="WeatherWidgetHost"   Grid.Column="0" VerticalAlignment="Top" />
            <Border x:Name="BluetoothWidgetHost" Grid.Column="2" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Window>
