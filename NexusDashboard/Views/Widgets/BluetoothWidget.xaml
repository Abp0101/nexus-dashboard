<UserControl
    x:Class="NEXUS.Views.Widgets.BluetoothWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border CornerRadius="20" Padding="22" BorderThickness="1" BorderBrush="{StaticResource GlassBorder}"
            Background="{StaticResource GlassBackground}"
            PointerEntered="Border_PointerEntered" PointerExited="Border_PointerExited"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CARD HEADER -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <!-- Using a grey dot for Bluetooth when inactive, blue/cyan when active could be done in code, 
                     but we'll use cyan as the base accent. -->
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyan}" VerticalAlignment="Center" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="BLUETOOTH DEvICES" FontSize="10" FontWeight="Medium" CharacterSpacing="200" 
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <!-- The count text is generated in code-behind so we'll just name a TextBlock here -->
                    <TextBlock x:Name="DeviceCountText" Grid.Column="1" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Device List Container -->
            <!-- We build the device cards programmatically in code-behind to avoid ItemsRepeater x:DataType issues -->
            <ScrollViewer Grid.Row="1" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="DeviceListPanel" Spacing="10" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
