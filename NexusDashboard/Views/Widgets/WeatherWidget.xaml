<UserControl
    x:Class="NEXUS.Views.Widgets.WeatherWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEXUS.Views.Widgets"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="#0A0F1A"
        CornerRadius="16"
        Padding="24"
        BorderBrush="#1A2540"
        BorderThickness="1">
        <StackPanel Spacing="12">
            <!-- Header + Description -->
            <TextBlock
                Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#AABBFF" />

            <!-- Temperature -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Temp"      Foreground="#667799" FontSize="14" Width="100" />
                <TextBlock Text="{x:Bind ViewModel.Temperature, Mode=OneWay}"
                           Foreground="White" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Wind -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Wind"      Foreground="#667799" FontSize="14" Width="100" />
                <TextBlock Text="{x:Bind ViewModel.WindSpeed, Mode=OneWay}"
                           Foreground="White" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Humidity -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Humidity"  Foreground="#667799" FontSize="14" Width="100" />
                <TextBlock Text="{x:Bind ViewModel.Humidity, Mode=OneWay}"
                           Foreground="White" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Location -->
            <TextBlock
                Text="📍 Chartham, Canterbury"
                Foreground="#445566"
                FontSize="11"
                FontStyle="Italic" />
        </StackPanel>
    </Border>
</UserControl>
