<UserControl
    x:Class="NEXUS.Views.Widgets.NetworkWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="#0A0F1A"
        CornerRadius="16"
        Padding="24"
        BorderBrush="#1A2540"
        BorderThickness="1">
        <StackPanel Spacing="12">
            <!-- Header -->
            <TextBlock
                Text="🌐 Network"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#AABBFF" />

            <!-- Download -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="↓ Download" Foreground="#667799" FontSize="14" Width="110" />
                <TextBlock Text="{x:Bind ViewModel.DownloadSpeedText, Mode=OneWay}"
                           Foreground="#44DDFF" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Upload -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="↑ Upload" Foreground="#667799" FontSize="14" Width="110" />
                <TextBlock Text="{x:Bind ViewModel.UploadSpeedText, Mode=OneWay}"
                           Foreground="#44DDFF" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Latency -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="📡 Ping" Foreground="#667799" FontSize="14" Width="110" />
                <TextBlock Text="{x:Bind ViewModel.LatencyText, Mode=OneWay}"
                           Foreground="#44DDFF" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
