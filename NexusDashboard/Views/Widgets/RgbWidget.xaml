<UserControl
    x:Class="NEXUS.Views.Widgets.RgbWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEXUS.Views.Widgets"
    xmlns:vm="using:NEXUS.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="#0A0F1A"
        CornerRadius="16"
        Padding="24"
        BorderBrush="#1A2540"
        BorderThickness="1">
        <StackPanel Spacing="14">
            <!-- Header + Master toggle -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                    Text="🎨 RGB Control"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#AABBFF"
                    VerticalAlignment="Center" />

                <ToggleSwitch Grid.Column="1"
                    x:Name="MasterToggle"
                    IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                    OnContent="ON"
                    OffContent="OFF"
                    MinWidth="0" />
            </Grid>

            <!-- Connection status -->
            <TextBlock
                Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                Foreground="#667799"
                FontSize="12" />

            <!-- Device list -->
            <ItemsRepeater x:Name="DeviceList" ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:RgbDeviceDisplay">
                        <Border Background="#0F1525" CornerRadius="8" Padding="10,8">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox: only for controllable devices -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              IsEnabled="{x:Bind IsControllable}"
                                              Visibility="{x:Bind IsControllable}"
                                              MinWidth="0" Padding="0"
                                              VerticalAlignment="Center" />

                                    <!-- Green dot for Essential devices -->
                                    <Ellipse Grid.Column="0"
                                             Width="10" Height="10"
                                             Fill="#44DD88"
                                             Visibility="{x:Bind IsHardwiredGreen}"
                                             VerticalAlignment="Center"
                                             Margin="4,0,4,0" />

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name}"
                                               Foreground="White"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0" />

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind ZoneLabel}"
                                               Foreground="#445566"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Essential ON/OFF buttons (shown programmatically) -->
            <StackPanel x:Name="EssentialButtons" Spacing="6" />

            <!-- Color picker (hidden when only Essential devices exist) -->
            <ColorPicker
                x:Name="RgbColorPicker"
                Color="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}"
                ColorSpectrumShape="Ring"
                IsAlphaEnabled="False"
                IsMoreButtonVisible="False"
                IsHexInputVisible="True" />

            <!-- Apply to Selected (only for non-Essential devices) -->
            <Button
                Content="Apply to Selected"
                Command="{x:Bind ViewModel.ApplyColorCommand}"
                HorizontalAlignment="Stretch"
                Background="#2244AA"
                Foreground="White"
                CornerRadius="8" />
        </StackPanel>
    </Border>
</UserControl>
