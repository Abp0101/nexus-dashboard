<UserControl
    x:Class="NEXUS.Views.Widgets.RgbWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border CornerRadius="20" Padding="22" BorderThickness="1" BorderBrush="{StaticResource GlassBorder}"
            Background="{StaticResource GlassBackground}"
            PointerEntered="Border_PointerEntered" PointerExited="Border_PointerExited"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CARD HEADER -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <!-- Using Violet for RGB header -->
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentViolet}" VerticalAlignment="Center" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ILLUMINATION" FontSize="10" FontWeight="Medium" CharacterSpacing="200" 
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <!-- Master Toggle Switch -->
                    <ToggleSwitch x:Name="MasterToggle" Grid.Column="1" HorizontalAlignment="Right" Margin="0,-4,0,0"
                                  IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                                  OffContent="" OnContent="" MinWidth="0" />
                </Grid>
            </StackPanel>

            <!-- Main Content Area -->
            <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center">
                
                <!-- Status Row -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                     <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyan}" VerticalAlignment="Center" />
                     <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Color Picker -->
                <ColorPicker x:Name="RgbColorPicker" ColorSpectrumShape="Ring" IsMoreButtonVisible="False" 
                             IsColorSliderVisible="True" IsColorChannelTextInputVisible="False" IsHexInputVisible="False" IsAlphaEnabled="False"
                             HorizontalAlignment="Center" Margin="0,8,0,16" ColorChanged="RgbColorPicker_ColorChanged" />

                <!-- Devices List (Built in code-behind) -->
                <ScrollViewer MaxHeight="80" VerticalScrollMode="Auto">
                    <StackPanel x:Name="DeviceListPanel" Spacing="8" />
                </ScrollViewer>

                <!-- Full Width Cyan Apply Button -->
                <Button Content="APPLY CONFIGURATION" Command="{x:Bind ViewModel.ApplyColorCommand}"
                        HorizontalAlignment="Stretch" Padding="0,12" CornerRadius="8"
                        Background="#1A00D4FF" BorderBrush="#3300D4FF" BorderThickness="1"
                        Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" CharacterSpacing="100">

                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
