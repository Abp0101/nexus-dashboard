<UserControl
    x:Class="NEXUS.Views.Widgets.RamWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border CornerRadius="20" Padding="22" BorderThickness="1.5" BorderBrush="{StaticResource GlassBorder}"
            Background="{StaticResource GlassBackground}"
            PointerEntered="Border_PointerEntered" PointerExited="Border_PointerExited">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CARD HEADER -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <Image Width="20" Height="20" VerticalAlignment="Center">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/Icons/ram-icon.svg" />
                    </Image.Source>
                </Image>
                <TextBlock Text="RAM" FontSize="10" FontWeight="Medium" CharacterSpacing="200" 
                           Foreground="#40FFFFFF" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="16">
                <!-- Big Numbers -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.RamUsed, Mode=OneWay}" FontSize="52" FontWeight="ExtraLight" FontFamily="Segoe UI Variable Display"
                                   Foreground="White" LineHeight="52" CharacterSpacing="-20" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,-4,0,0">
                        <TextBlock Text="of" FontSize="14" Foreground="#73FFFFFF" />
                        <TextBlock Text="{x:Bind ViewModel.RamTotal, Mode=OneWay}" FontSize="14" Foreground="#73FFFFFF" />
                        <TextBlock Text="GB" FontSize="14" Foreground="#73FFFFFF" />
                    </StackPanel>
                </StackPanel>

                <!-- Full Width 4px Gradient Bar -->
                <Border Height="4" CornerRadius="99" Background="{StaticResource ProgressBarTrack}">
                    <Border x:Name="UsageBar" CornerRadius="99" HorizontalAlignment="Left" Width="120">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00D4FF" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <!-- Secondary Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="AVAILABLE" FontSize="11" FontFamily="Consolas" Foreground="#40FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.RamAvailable, Mode=OneWay}" FontSize="12" FontFamily="Consolas" Foreground="#73FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RamUsagePercentText, Mode=OneWay}" 
                               FontSize="12" FontFamily="Consolas" Foreground="#73FFFFFF" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
