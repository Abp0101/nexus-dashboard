<UserControl
    x:Class="NEXUS.Views.Widgets.RamWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border CornerRadius="20" Padding="22" BorderThickness="1" BorderBrush="{StaticResource GlassBorder}"
            Background="{StaticResource GlassBackground}"
            PointerEntered="Border_PointerEntered" PointerExited="Border_PointerExited">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CARD HEADER -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyan}" VerticalAlignment="Center" />
                <TextBlock Text="RAM" FontSize="10" FontWeight="Medium" CharacterSpacing="200" 
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="16">
                <!-- Big Numbers -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.RamUsed, Mode=OneWay}" FontSize="52" FontWeight="ExtraLight" 
                                   Foreground="{StaticResource TextPrimary}" LineHeight="52" CharacterSpacing="-20" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,-4,0,0">
                        <TextBlock Text="of" FontSize="14" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.RamTotal, Mode=OneWay}" FontSize="14" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Full Width Gradient Bar -->
                <Border Height="8" CornerRadius="99" Background="{StaticResource ProgressBarTrack}">
                    <Border x:Name="UsageBar" CornerRadius="99" HorizontalAlignment="Left" Width="120">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource AccentCyanColor}" Offset="0" />
                                <GradientStop Color="{StaticResource AccentVioletColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <!-- Secondary Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="AVAILABLE" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.RamAvailable, Mode=OneWay}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RamUsagePercentText, Mode=OneWay}" 
                               FontSize="14" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
