<UserControl
    x:Class="NEXUS.Views.Widgets.CpuWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEXUS.Views.Widgets"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="#0A0F1A"
        CornerRadius="16"
        Padding="24"
        BorderBrush="#1A2540"
        BorderThickness="1">
        <StackPanel Spacing="12">
            <!-- Header -->
            <TextBlock
                Text="⚡ CPU"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#AABBFF" />

            <!-- Load -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Load"     Foreground="#667799" FontSize="14" Width="100" />
                <TextBlock Text="{x:Bind ViewModel.CpuLoad, Mode=OneWay}"
                           Foreground="White" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Temperature — unavailable on AMD Ryzen without WinRing0 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Temp"     Foreground="#667799" FontSize="14" Width="100" />
                <TextBlock Text="Unavailable on AMD"
                           Foreground="#445566" FontSize="12" FontStyle="Italic"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Clock Speed -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Clock"    Foreground="#667799" FontSize="14" Width="100" />
                <TextBlock Text="{x:Bind ViewModel.CpuClock, Mode=OneWay}"
                           Foreground="White" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
