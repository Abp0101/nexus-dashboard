<UserControl
    x:Class="NEXUS.Views.Widgets.GpuWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border CornerRadius="20" Padding="22" BorderThickness="1" BorderBrush="{StaticResource GlassBorder}"
            Background="{StaticResource GlassBackground}"
            PointerEntered="Border_PointerEntered" PointerExited="Border_PointerExited">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CARD HEADER -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentViolet}" VerticalAlignment="Center" />
                <TextBlock Text="GPU" FontSize="10" FontWeight="Medium" CharacterSpacing="200" 
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Arc Gauge Container -->
                <Grid Grid.Column="0" Width="110" Height="110" Margin="0,0,24,0">
                    <Path Stroke="#0FFFFFFF" StrokeThickness="6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 21.0,84.0 A 45,45 0 1 1 89.0,84.0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Path x:Name="UsageArc" StrokeThickness="6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 21.0,84.0 A 45,45 0 1 1 89.0,84.0" HorizontalAlignment="Center" VerticalAlignment="Center"
                          StrokeDashArray="141.3 282.7">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource AccentVioletColor}" Offset="0" />
                                <GradientStop Color="{StaticResource AccentCyanColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.GpuLoad, Mode=OneWay}" FontSize="22" FontWeight="SemiLight" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="LOAD" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Big Numbers & Stats -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                     <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="16">
                        <TextBlock Text="{x:Bind ViewModel.GpuLoad, Mode=OneWay}" FontSize="52" FontWeight="ExtraLight" 
                                   Foreground="{StaticResource TextPrimary}" LineHeight="52" CharacterSpacing="-20" Margin="0,0,0,-8" />
                        
                        <!-- Temperature Pill -->
                        <Border CornerRadius="99" Padding="10,4" BorderThickness="1" 
                                Background="{x:Bind ViewModel.GpuTempBg, Mode=OneWay}"
                                BorderBrush="{x:Bind ViewModel.GpuTempBorder, Mode=OneWay}"
                                VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <TextBlock Text="{x:Bind ViewModel.GpuTemp, Mode=OneWay}" FontSize="12" FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="{x:Bind ViewModel.GpuTempFg, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="VRAM" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.GpuVram, Mode=OneWay}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Thin VRAM Bar -->
                        <Border Height="4" CornerRadius="99" Background="{StaticResource ProgressBarTrack}" Margin="0,0,0,4">
                           <!-- Fill is handled in code-behind via percentage or static if not strictly animated at 300ms -->
                            <Border x:Name="VramBar" CornerRadius="99" HorizontalAlignment="Left" Width="60">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource AccentVioletColor}" Offset="0" />
                                        <GradientStop Color="#FF6B35" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="CLOCK" FontSize="10" Foreground="{StaticResource TextMuted}" Width="40" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.GpuClock, Mode=OneWay}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
