<UserControl
    x:Class="NEXUS.Views.Widgets.GpuWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border CornerRadius="20" Padding="22" BorderThickness="1.5" BorderBrush="{StaticResource GlassBorder}"
            Background="{StaticResource GlassBackground}"
            PointerEntered="Border_PointerEntered" PointerExited="Border_PointerExited">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CARD HEADER -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <Image Width="20" Height="20" VerticalAlignment="Center">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/Icons/gpu-icon.svg" />
                    </Image.Source>
                </Image>
                <TextBlock Text="GPU" FontSize="10" FontWeight="Medium" CharacterSpacing="200" 
                           Foreground="#40FFFFFF" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Arc Gauge Container -->
                <Grid Grid.Column="0" Width="110" Height="110" Margin="0,0,24,0">
                    <Path Stroke="#0FFFFFFF" StrokeThickness="6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 21.0,84.0 A 45,45 0 1 1 89.0,84.0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Path x:Name="UsageArc" StrokeThickness="6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 21.0,84.0 A 45,45 0 1 1 89.0,84.0" HorizontalAlignment="Center" VerticalAlignment="Center"
                          StrokeDashArray="141.3 282.7">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5CF6" Offset="0" />
                                <GradientStop Color="#00D4FF" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.GpuLoad, Mode=OneWay}" FontSize="22" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="LOAD" FontSize="9" Foreground="#40FFFFFF" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Big Numbers & Stats -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                     <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.GpuLoad, Mode=OneWay}" FontSize="52" FontWeight="ExtraLight" FontFamily="Segoe UI Variable Display"
                                       Foreground="White" LineHeight="52" CharacterSpacing="-20" Margin="0,0,4,-8" />
                            <TextBlock Text="%" FontSize="18" Foreground="#73FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                        
                        <!-- Temperature Pill -->
                        <Border CornerRadius="99" Padding="10,4" BorderThickness="1.5" 
                                Background="{x:Bind ViewModel.GpuTempBg, Mode=OneWay}"
                                BorderBrush="{x:Bind ViewModel.GpuTempBorder, Mode=OneWay}"
                                VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <TextBlock Text="{x:Bind ViewModel.GpuTemp, Mode=OneWay}" FontSize="12" FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="{x:Bind ViewModel.GpuTempFg, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="VRAM" FontSize="11" FontFamily="Consolas" Foreground="#40FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.GpuVram, Mode=OneWay}" FontSize="11" FontFamily="Consolas" Foreground="#73FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Thin VRAM Bar -->
                        <Border Height="4" CornerRadius="99" Background="{StaticResource ProgressBarTrack}" Margin="0,0,0,4">
                            <Border x:Name="VramBar" CornerRadius="99" HorizontalAlignment="Left" Width="60">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8B5CF6" Offset="0" />
                                        <GradientStop Color="#00D4FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="CLOCK" FontSize="11" FontFamily="Consolas" Foreground="#00D4FF" Width="40" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.GpuClock, Mode=OneWay}" FontSize="11" FontFamily="Consolas" Foreground="#00D4FF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
