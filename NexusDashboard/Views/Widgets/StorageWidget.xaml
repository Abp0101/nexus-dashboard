<UserControl
    x:Class="NEXUS.Views.Widgets.StorageWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NEXUS.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="#0A0F1A"
        CornerRadius="16"
        Padding="24"
        BorderBrush="#1A2540"
        BorderThickness="1">
        <StackPanel Spacing="12">
            <!-- Header -->
            <TextBlock
                Text="💾 Storage"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#AABBFF" />

            <!-- Drive list -->
            <ItemsRepeater x:Name="DriveList" ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:DriveInfoViewModel">
                        <StackPanel Spacing="4">
                            <!-- Drive name + type -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind DriveName}"
                                               Foreground="White" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind DriveLabel}"
                                               Foreground="#667799" FontSize="13" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind DriveTypeLabel}"
                                           Foreground="#445566" FontSize="11" FontStyle="Italic"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Usage text -->
                            <TextBlock Text="{x:Bind UsageText}"
                                       Foreground="#889AAB" FontSize="12" />

                            <!-- Progress bar (built in code-behind for color) -->
                            <Grid Height="6" CornerRadius="3">
                                <Border Background="#151E2E" CornerRadius="3" />
                                <!-- The colored bar is added programmatically -->
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </Border>
</UserControl>
