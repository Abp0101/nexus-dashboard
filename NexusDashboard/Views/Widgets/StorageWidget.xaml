<UserControl
    x:Class="NEXUS.Views.Widgets.StorageWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border CornerRadius="20" Padding="22" BorderThickness="1.5" BorderBrush="{StaticResource GlassBorder}"
            Background="{StaticResource GlassBackground}"
            PointerEntered="Border_PointerEntered" PointerExited="Border_PointerExited"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CARD HEADER -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <Image Width="20" Height="20" VerticalAlignment="Center">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/Icons/storage-icon.svg" />
                    </Image.Source>
                </Image>
                <TextBlock Text="STORAGE VOLUMES" FontSize="10" FontWeight="Medium" CharacterSpacing="200" 
                           Foreground="#40FFFFFF" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Drive List Container -->
            <ScrollViewer Grid.Row="1" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="DriveListPanel" Spacing="16" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
